# Copy to .env.local for local development, or add these in your host's dashboard (e.g. Vercel → Settings → Environment Variables).
# Every variable is optional. The site builds and runs without any of them.

# ── Site URL ────────────────────────────────────────────────────────────────
# Your public address once you have one, e.g. https://example.com (no trailing slash).
# Used for canonical links, Open Graph URLs and the sitemap. Leave empty until the domain is live.
NEXT_PUBLIC_SITE_URL=

# ── Contact form delivery (Resend) ──────────────────────────────────────────
# Without these, the form never pretends to send: it tells the visitor that online delivery
# isn't configured and offers your email address instead (set it in lib/site-config.ts).
# Server-only — never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# The inbox that receives messages from the form.
CONTACT_TO_EMAIL=
# A sender on a domain you have verified in Resend, e.g. "Portfolio <hello@example.com>".
# While testing, Resend's shared sender "Portfolio <onboarding@resend.dev>" only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=
